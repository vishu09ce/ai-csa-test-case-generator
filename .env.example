# Copy this file to .env and fill in your values
# Never commit .env to GitHub

GROQ_API_KEY=your_groq_api_key_here
LITELLM_MODEL=groq/openai/gpt-oss-120b
DATABASE_URL=sqlite:///./app.db
# Local development
FRONTEND_URL=http://localhost:5173
# Production (GitHub Pages)
# FRONTEND_URL=https://vishu09ce.github.io

# Frontend — backend URL (set in frontend/.env.local for local dev)
# VITE_BACKEND_URL=https://ai-csa-backend.onrender.com

# Keep-alive: on Render the backend pings its own /health every 10 minutes so
# the free instance does not sleep. Runs only when RENDER_EXTERNAL_URL (set by
# Render) or KEEP_ALIVE_URL is present.
# KEEP_ALIVE_ENABLED=false
# KEEP_ALIVE_INTERVAL_SECONDS=600
